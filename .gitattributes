# Шрифты — двоичные файлы: git не трогает в них концы строк, даже если на
# машине включён core.autocrlf. Байт, «исправленный» с LF на CRLF, ломает
# шрифт, и браузер молча берёт системный.
*.ttf binary
# Значки (tools/icons.py) — тоже: PNG с «исправленным» концом строки браузер
# не покажет, и на экране «Домой» окажется снимок страницы.
*.png binary

# Образцы файла копии прошлых версий (Правило 2) — история, байт в байт:
# git не трогает в них концы строк, а тест сверяет их такими, какими их
# сохранила программа.
crates/core/tests/backups/**/*.json -text

# Образцы курсов ЦБ (задача 43): ответ ЦБ и файл курсов, который из него
# пишет `tools/deploy/rates.mjs`, — байт в байт: `tools/browser/check.mjs`
# сверяет вывод программы выкладки с файлом, который читает тест ядра.
crates/core/tests/rates/** -text

# Дизайн человека «Kvartik Design» — файл как он есть, байт в байт: git не
# трогает в нём концы строк.
docs/design/** -text

# Скрипты bash (tools/deploy/check.sh) — с концами строк LF и на Windows:
# bash читает `\r` частью команды, и скрипт падает на первой строке.
*.sh text eol=lf

# Правила Claude Code `.claude/rules/` (с 0.0.179) — тоже LF и на Windows:
# с core.autocrlf git выдавал их с CRLF, а шапку `paths:` с CRLF ни тест
# `crates/app/tests/claude_md.rs`, ни, может быть, Claude Code не узнают —
# и файл грузился бы в каждую сессию (найдено после выкладки 0.0.179).
.claude/rules/** text eol=lf
