{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(rustc --version)",
      "Bash(cargo build *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo outdated *)",
      "Bash(cargo update *)",
      "Bash(cargo upgrade *)",
      "Bash(cargo tree *)",
      "Bash(trunk --version)",
      "Bash(trunk build *)",
      "Bash(trunk serve *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin main)",
      "Bash(git merge --squash *)",
      "Bash(git worktree *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git check-ignore *)",
      "Bash(gh run *)",
      "PowerShell(rustc --version)",
      "PowerShell(cargo build *)",
      "PowerShell(cargo clippy *)",
      "PowerShell(cargo test *)",
      "PowerShell(cargo outdated *)",
      "PowerShell(cargo update *)",
      "PowerShell(cargo upgrade *)",
      "PowerShell(cargo tree *)",
      "PowerShell(trunk --version)",
      "PowerShell(trunk build *)",
      "PowerShell(trunk serve *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push origin main)",
      "PowerShell(git merge --squash *)",
      "PowerShell(git worktree *)",
      "PowerShell(git branch *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git ls-files *)",
      "PowerShell(git check-ignore *)",
      "PowerShell(gh run *)",
      "Bash(node .claude/*)",
      "PowerShell(node .claude/*)",
      "Read(~/.cargo/registry/src/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/lf.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
