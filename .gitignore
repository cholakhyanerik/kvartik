/target
# Собранный сайт (`trunk build`, `trunk serve`): его собирает выкладка из
# исходников, а в репозитории он только устаревал бы.
dist/
# Рабочие копии агентов (git worktree, Правило 12 в CLAUDE.md). В каждой лежит
# свой `.git`-файл, и `git add .` из Правила 11 добавил бы её в коммит
# вложенным репозиторием — битой записью вместо файлов.
/.claude/worktrees/
# Настройки Claude Code одной машины: разовые разрешения с её путями.
# Прятать их глобальным правилом git мало — на другом ПК его может не быть,
# и `git add .` унёс бы их в репозиторий.
/.claude/settings.local.json
# Ключи. Закрытый ключ лицензий живёт вне рабочей копии всегда («Общее»
# в CLAUDE.md), а эти шаблоны — страховка на случай, если его всё-таки
# положат рядом: утёкший ключ — бесплатные лицензии навсегда, отозвать его без
# сервера нельзя.
*.key
*.pem
keys/
# Окружение Python для пересборки шрифтов (tools/fonts.py): fontTools
# ставится туда, а не в систему, и в репозитории ему не место.
/.venv-fonts/
